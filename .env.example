# Copy this file to .env and replace each placeholder.
IQAIR_API_KEY=replace_with_your_key
TOMTOM_API_KEY=replace_with_your_key
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Use the pooled Neon connection string for the deployed API.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require

# DataHub's PostgreSQL connector requires the host separately.
DATAHUB_POSTGRES_HOST=your-endpoint.neon.tech

# Required for the agent to read source contracts through the self-hosted
# DataHub MCP server and write completed investigations through DataHub's REST API.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=replace_with_your_datahub_personal_access_token
# Historical name: this gates REST document write-back, not an MCP write tool.
DATAHUB_MCP_WRITE_ENABLED=false

# This is the browser origin allowed to call the Python API.
FRONTEND_URL=http://localhost:3000
